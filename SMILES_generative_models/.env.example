# Copy to `.env` and fill in real values.
# Loaded at container startup via `docker run --env-file .env`; also picked
# up locally via python-dotenv in main_mcp.py / main_api.py.

# ---- S3 / object storage (training datasets, weights, generated molecules, state) ----
# Endpoint of the S3-compatible service (e.g. https://s3.example.com or http://minio:9000).
ENDPOINT_URL=http://10.32.1.114:9000
ACCESS_KEY=
SECRET_KEY=
# Bucket name for inputs/outputs.
BUCKET_NAME=molecule-generative-mcp

# ---- HuggingFace ----
# Required only when uploading GAN weights to a private HF repo
# (see GAN/gan_lstm_refactoring/train_gan.py). Leave blank if not used at runtime.
HF_TOKEN=

# ---- Service URLs ----
# URL of the AutoML/predictive ML server (used by case_trainer / generators).
ML_MOLS_MODEL_APP_URL=

# ---- FastAPI ports ----
# Port for the local FastAPI generative server (main_api.py).
GEN_MOLS_MODEL_APP_PORT=8000
# Port for the FastMCP HTTP transport (main_mcp.py).
MOLS_GEN_MCP_PORT=8000
# Optional MCP transport: "http" (default) or "stdio".
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0

# ---- Optional tuning ----
# HTTP timeout (seconds) for GAN training/generation calls from MCP to FastAPI.
GAN_HTTP_TIMEOUT_S=1160
