# Shell scripts MUST be LF — they run inside a Linux container where bash
# treats a trailing \r as part of the last token (cd target, env name, etc.)
# and silently breaks every command.
*.sh text eol=lf
api.sh text eol=lf

# Same goes for Dockerfile and any docker-compose YAML executed in Linux.
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
docker-compose*.yaml text eol=lf

# Treat .env files as text with LF (consumed by Linux containers).
.env* text eol=lf
