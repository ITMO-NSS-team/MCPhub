# Copy to `.env` and fill in real values.
# Loaded at container startup via docker-compose `env_file:` (or
# `docker run --env-file .env`); also picked up locally via python-dotenv
# in automl_mcp.py / s3_utils.py.

# ---- S3 / object storage (training datasets, weights, predictions, state) ----
# Endpoint of the S3-compatible service (e.g. https://s3.example.com or http://minio:9000).
ENDPOINT_URL=http://10.32.1.114:9000
ACCESS_KEY=
SECRET_KEY=
# Bucket name for inputs/outputs.
BUCKET_NAME=molecule-generative-mcp
# S3 key under which the shared state.json lives.
STATE_S3_KEY=state/state.json

# ---- MCP server runtime ----
# Bind host/port for the FastMCP HTTP transport. The server listens on
# 0.0.0.0:$MOLS_ML_MCP_PORT inside the container.
MOLS_ML_MCP_PORT=8777
MCP_HOST=0.0.0.0
# Transport: "http" (default) or "stdio".
MCP_TRANSPORT=http
