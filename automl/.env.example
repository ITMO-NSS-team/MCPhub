# Copy to `.env` and fill in real values.
# Loaded at container startup via `docker run --env-file .env`; also picked
# up locally via python-dotenv in automl_mcp.py / s3_utils.py.

# ---- S3 / object storage (training datasets, weights, predictions, state) ----
# Endpoint of the S3-compatible service (e.g. https://s3.example.com or http://minio:9000).
ENDPOINT_URL=http://10.32.1.114:9000
ACCESS_KEY=
SECRET_KEY=
# Bucket name for inputs/outputs.
BUCKET_NAME=molecule-generative-mcp

# ---- MCP server runtime ----
# Bind host/port for the FastMCP HTTP transport. The server listens on
# 0.0.0.0:$MOLS_ML_MCP_PORT inside the container.
MOLS_ML_MCP_PORT=8777
MCP_HOST=0.0.0.0
# Transport: "http" (default) or "stdio".
MCP_TRANSPORT=http

# ---- Training dataset size cap ----
# Caps the number of rows used for AutoML training to keep the FEDOT
# pipeline within the container's memory budget. Applied in
# `api_utils.train_ml_with_data` right before the CSV is handed to
# `run_train_automl`.
#   TEST         -> 200 rows   (smoke tests / CI)
#   LIMITED_DEV  -> 10 000 rows (default, safe on low-memory hosts)
#   UNLIMITED    -> no cap     (only for hosts with plenty of RAM 30GB +)
TRAIN_DATA_LIMIT=LIMITED_DEV
